# Copy to state.backend.hcl after applying ./bootstrap.
# OCI Object Storage's S3-compatible endpoint requires Customer Secret Key
# credentials, provided at init time through AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY (do not put them in this file).
bucket = "tofu-state"
key    = "terraform.tfstate"
region = "eu-frankfurt-1"
profile = "oci-tofu"

skip_region_validation      = true
skip_credentials_validation = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true
use_path_style              = true

endpoints = {
  s3 = "https://YOUR_OBJECT_STORAGE_NAMESPACE.compat.objectstorage.eu-frankfurt-1.oraclecloud.com"
}
