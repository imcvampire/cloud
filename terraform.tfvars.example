# Copy to terraform.tfvars and fill these from OCI's API-key setup.
tenancy_ocid     = "ocid1.tenancy.oc1..example"
user_ocid        = "ocid1.user.oc1..example"
fingerprint      = "aa:bb:cc:dd"
private_key_path = "/absolute/path/to/oci_api_key.pem"
region           = "eu-frankfurt-1"
ssh_public_key   = "ssh-ed25519 AAAA... you@example"

# Used only by the one-time `bootstrap/` state-bucket deployment.
state_bucket_name = "tofu-state"

# SSH and the dashboard have independent access controls.
admin_cidrs     = ["203.0.113.10/32"]
dashboard_cidrs = ["203.0.113.10/32"]

# Public resolvers can be abused. Restrict this when the resolver is private.
# dns_cidrs = ["203.0.113.0/24"]
